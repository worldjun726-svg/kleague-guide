{
  "name": "kleague-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/data.test.ts tests/sample-api.test.ts tests/current-data.test.ts",
    "test:current": "node scripts/current-check.mjs",
    "test:top-five": "node scripts/all-team-top-five-check.mjs",
