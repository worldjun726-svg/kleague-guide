    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "playwright": "^1.57.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
