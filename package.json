    "test:sample": "node scripts/sample-data-check.mjs",
    "test:landing": "node scripts/landing-check.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
