    "test:browser": "node node_modules/playwright/cli.js test",
    "data:demo": "python scripts/generate_demo.py",
    "test:browser:smoke": "node scripts/browser-smoke.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "build:bundle": "node node_modules/vite/bin/vite.js build",
